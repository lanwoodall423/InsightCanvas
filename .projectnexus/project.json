        ]
      }
    ],
    "procedures": [
      {
        "procedureId": "runtime.acceptance",
        "title": "Waylith in-game acceptance",
        "steps": [
          "Confirm the installed RimWorld game is version 1.7 (Waylith) and has Assembly-CSharp.dll, Waylith.dll and UnityStubs.dll.",
          "Build the net10.0 framework and independent consumer, and compare fresh 1.7/Assemblies DLL/XML to the source build.",
          "Package the 1.7-only output and verify it includes exactly one framework DLL with no legacy 1.6 directories.",
          "Confirm 1.7-compatible RimBridgeServer and the test companion; use RimLiaison as the sole runtime authority and deploy an immutable candidate.",
          "Exercise all ten Feature Showcase pages, wide/narrow layout, controls, focus, semantic views, diagnostics and owner cleanup.",
          "Record exact game build, commit, candidate and artifact hashes, attributable errors, test result and restored runtime state before approving."
        ],
        "requirements": {
          "platform": "win32",
          "hardware": []
        }
      }
    ]
  }
